// ─────────────────────────────────────────────────────────────────────────────
// Shape Layer
//
// shape_type: circle | rect | rounded_rect | polygon | arc | ring |
//             diagonal_split | star | blob
// ─────────────────────────────────────────────────────────────────────────────

class _ShapeLayer extends StatelessWidget {
  const _ShapeLayer({
    required this.layer,
    required this.w,
    required this.h,
    this.isSelected = false,
    this.onTap,
    this.index,

  });
  final VoidCallback? onTap;
  final int? index;

  final Map<String, dynamic> layer;
  final double w, h;
  final bool isSelected;

  @override
  Widget build(BuildContext context) {
    final x = _f(layer['x']) * w;
    final y = _f(layer['y']) * h;
    final scale = _f(layer['scale'], 1.0);
    final width = (_f(layer['width'], _f(layer['size'], 0.3))) * w * scale;
    final height =
        (layer['height'] != null ? _f(layer['height']) * h : width) * scale;
    final color = _color(layer['color']);
    final rotation = _f(layer['rotation']); // degrees
    final opacity = _f(layer['opacity'], 1.0);
    final shapeType =
        layer['shape_type'] as String? ?? layer['shape'] as String? ?? 'circle';

    // Gradient fill for shapes
    final gradList = layer['gradient_colors'] as List?;
    final gradient = gradList != null && gradList.length >= 2
        ? LinearGradient(
            begin: _alignment(layer['gradient_begin'] as String?),
            end: _alignment(
                layer['gradient_end'] as String? ?? 'bottomRight'),
            colors: gradList.map((c) => _color(c)).toList(),
          )
        : null;

    Widget shape;
    switch (shapeType) {
      case 'circle':
        shape = Container(
          width: width,
          height: height,
          decoration: BoxDecoration(
            color: gradient == null ? color : null,
            gradient: gradient,
            shape: BoxShape.circle,
          ),
        );
        break;

      case 'rect':
        shape = Container(
          width: width,
          height: height,
          decoration: BoxDecoration(
            color: gradient == null ? color : null,
            gradient: gradient,
          ),
        );
        break;

      case 'rounded_rect':
        final cr = _f(layer['corner_radius'], 16.0);
        shape = Container(
          width: width,
          height: height,
          decoration: BoxDecoration(
            color: gradient == null ? color : null,
            gradient: gradient,
            borderRadius: BorderRadius.circular(cr),
          ),
        );
        break;

      case 'ring':
        final strokeW = _f(layer['stroke_width'], 8.0);
        shape = SizedBox(
          width: width,
          height: height,
          child: CustomPaint(
            painter: _RingPainter(color: color, strokeWidth: strokeW),
          ),
        );
        break;

      case 'arc':
        final startAngle = _f(layer['start_angle'], -math.pi / 2);
        final sweepAngle = _f(layer['sweep_angle'], math.pi * 1.5);
        final strokeW = _f(layer['stroke_width'], 8.0);
        shape = SizedBox(
          width: width,
          height: height,
          child: CustomPaint(
            painter: _ArcPainter(
              color: color,
              strokeWidth: strokeW,
              startAngle: startAngle,
              sweepAngle: sweepAngle,
            ),
          ),
        );
        break;

      case 'polygon':
        final sides = layer['sides'] as int? ?? 6;
        shape = SizedBox(
          width: width,
          height: height,
          child: CustomPaint(
            painter: _PolygonPainter(
              color: gradient == null ? color : null,
              gradient: gradient,
              sides: sides,
            ),
          ),
        );
        break;

      case 'star':
        final points = layer['points'] as int? ?? 5;
        final innerRatio = _f(layer['inner_ratio'], 0.45);
        shape = SizedBox(
          width: width,
          height: height,
          child: CustomPaint(
            painter: _StarPainter(
              color: color,
              points: points,
              innerRatio: innerRatio,
            ),
          ),
        );
        break;

      case 'diagonal_split':
        final color2 = _color(layer['color2'], color);
        shape = SizedBox(
          width: width,
          height: height,
          child: CustomPaint(
            painter: _DiagonalSplitPainter(color1: color, color2: color2),
          ),
        );
        break;

      case 'blob':
      default:
        shape = SizedBox(
          width: width,
          height: height,
          child: CustomPaint(
            painter: _BlobPainter(color: color),
          ),
        );
        break;
    }

    return _Positioner(
      layer: layer, w: w, h: h,
      child: _withSelection(
        Opacity(
          opacity: opacity.clamp(0.0, 1.0),
          child: rotation != 0
              ? Transform.rotate(
                  angle: rotation * math.pi / 180,
                  child: shape,
                )
              : shape,
        ),
        isSelected,
      ),
    );
  }
}

// ── Custom painters ────────────────────────────────────────────────────────

class _RingPainter extends CustomPainter {
  _RingPainter({required this.color, required this.strokeWidth});
  final Color color;
  final double strokeWidth;
  @override
  void paint(Canvas canvas, Size size) {
    final paint = Paint()
      ..color = color
      ..style = PaintingStyle.stroke
      ..strokeWidth = strokeWidth;
    canvas.drawOval(
      Rect.fromLTWH(
          strokeWidth / 2, strokeWidth / 2, size.width - strokeWidth,
          size.height - strokeWidth),
      paint,
    );
  }

  @override
  bool shouldRepaint(covariant CustomPainter oldDelegate) => false;
}

class _ArcPainter extends CustomPainter {
  _ArcPainter({
    required this.color,
    required this.strokeWidth,
    required this.startAngle,
    required this.sweepAngle,
  });
  final double strokeWidth, startAngle, sweepAngle;
  final Color color;
  @override
  void paint(Canvas canvas, Size size) {
    final paint = Paint()
      ..color = color
      ..style = PaintingStyle.stroke
      ..strokeWidth = strokeWidth
      ..strokeCap = StrokeCap.round;
    canvas.drawArc(
      Rect.fromLTWH(strokeWidth / 2, strokeWidth / 2,
          size.width - strokeWidth, size.height - strokeWidth),
      startAngle,
      sweepAngle,
      false,
      paint,
    );
  }

  @override
  bool shouldRepaint(covariant CustomPainter oldDelegate) => false;
}

class _PolygonPainter extends CustomPainter {
  _PolygonPainter({this.color, this.gradient, required this.sides});
  final Color? color;
  final Gradient? gradient;
  final int sides;
  @override
  void paint(Canvas canvas, Size size) {
    final path = Path();
    final cx = size.width / 2;
    final cy = size.height / 2;
    final r = math.min(cx, cy);
    for (int i = 0; i < sides; i++) {
      final angle = (2 * math.pi * i / sides) - math.pi / 2;
      final px = cx + r * math.cos(angle);
      final py = cy + r * math.sin(angle);
      i == 0 ? path.moveTo(px, py) : path.lineTo(px, py);
    }
    path.close();
    final paint = Paint();
    if (gradient != null) {
      paint.shader =
          gradient!.createShader(Rect.fromLTWH(0, 0, size.width, size.height));
    } else {
      paint.color = color!;
    }
    canvas.drawPath(path, paint);
  }

  @override
  bool shouldRepaint(covariant CustomPainter oldDelegate) => false;
}

class _StarPainter extends CustomPainter {
  _StarPainter(
      {required this.color, required this.points, required this.innerRatio});
  final Color color;
  final int points;
  final double innerRatio;
  @override
  void paint(Canvas canvas, Size size) {
    final cx = size.width / 2;
    final cy = size.height / 2;
    final outerR = math.min(cx, cy);
    final innerR = outerR * innerRatio;
    final path = Path();
    for (int i = 0; i < points * 2; i++) {
      final angle = (math.pi * i / points) - math.pi / 2;
      final r = i.isEven ? outerR : innerR;
      final px = cx + r * math.cos(angle);
      final py = cy + r * math.sin(angle);
      i == 0 ? path.moveTo(px, py) : path.lineTo(px, py);
    }
    path.close();
    canvas.drawPath(path, Paint()..color = color);
  }

  @override
  bool shouldRepaint(covariant CustomPainter oldDelegate) => false;
}

class _DiagonalSplitPainter extends CustomPainter {
  _DiagonalSplitPainter({required this.color1, required this.color2});
  final Color color1, color2;
  @override
  void paint(Canvas canvas, Size size) {
    canvas.drawRect(Rect.fromLTWH(0, 0, size.width, size.height),
        Paint()..color = color1);
    final path = Path()
      ..moveTo(size.width, 0)
      ..lineTo(size.width, size.height)
      ..lineTo(0, size.height)
      ..close();
    canvas.drawPath(path, Paint()..color = color2);
  }

  @override
  bool shouldRepaint(covariant CustomPainter oldDelegate) => false;
}

class _BlobPainter extends CustomPainter {
  _BlobPainter({required this.color});
  final Color color;
  @override
  void paint(Canvas canvas, Size size) {
    final cx = size.width / 2;
    final cy = size.height / 2;
    final path = Path();
    path.moveTo(cx, cy - size.height * 0.42);
    path.cubicTo(
      cx + size.width * 0.52, cy - size.height * 0.42,
      cx + size.width * 0.50, cy + size.height * 0.15,
      cx + size.width * 0.35, cy + size.height * 0.40,
    );
    path.cubicTo(
      cx + size.width * 0.10, cy + size.height * 0.52,
      cx - size.width * 0.38, cy + size.height * 0.48,
      cx - size.width * 0.46, cy + size.height * 0.12,
    );
    path.cubicTo(
      cx - size.width * 0.56, cy - size.height * 0.20,
      cx - size.width * 0.34, cy - size.height * 0.48,
      cx, cy - size.height * 0.42,
    );
    path.close();
    canvas.drawPath(path, Paint()..color = color);
  }

  @override
  bool shouldRepaint(covariant CustomPainter oldDelegate) => false;
}

